---
import Base from '../layouts/Base.astro';
import SectionRule from '../components/SectionRule.astro';
import Esiti from '../components/Esiti.astro';
import { Button } from '../../design-system/components/core/Button.jsx';
import { SITE, DISCIPLINE } from '../content.js';

const discCard = 'background:var(--surface-1);border:1px solid var(--border-subtle);border-radius:3px;padding:28px;display:grid;grid-template-columns:44px 1fr;gap:20px;align-items:start';
---

<Base
  title="Progetti — TORC"
  description="Ogni progetto che sviluppiamo è open source, pubblico dal primo commit. Sei filoni tecnologici, poche cose portate fino in fondo."
>

<section class="torc-field" data-field="schematic" data-field-glow="wash" data-field-depth="hero" style="padding:112px 64px 64px">
<div style="max-width:1280px;margin:0 auto">
<span class="torc-kicker">Progetti</span>
<h1 style="font-family:var(--font-display);font-size:clamp(40px,4.6vw,64px);font-weight:600;line-height:1.04;letter-spacing:-.03em;color:var(--text-strong);margin:20px 0 0;max-width:24ch">Tutto ciò che creiamo è aperto.</h1>
<p style="font-size:20px;line-height:1.62;color:var(--text-secondary);max-width:56ch;margin:24px 0 0">Ogni progetto che sviluppiamo è open source, pubblico dal primo commit. Scegliamo poche cose e le portiamo fino in fondo.</p>
</div>
</section>

<div data-theme="light" style="background:var(--bg-page);color:var(--text-body)">
<section style="padding:96px 64px 0">
<div style="max-width:1280px;margin:0 auto">
<SectionRule index="01 / 03" label="Repository" note="0 pubblici" mb="40px" />
<div class="torc-field torc-hud" data-field="schematic" data-field-depth="open" style="border:1px solid var(--border-subtle);border-radius:3px;padding:56px 40px;display:flex;flex-direction:column;align-items:center;gap:16px;text-align:center">
<span class="torc-hud-label">Stato · in apertura</span>
<h2 style="font-family:var(--font-display);font-size:30px;font-weight:600;letter-spacing:-.025em;color:var(--text-strong);margin:0">Nessun repository pubblico.</h2>
<p style="font-size:17px;line-height:1.6;color:var(--text-secondary);margin:0;max-width:48ch">Il primo arriva con il lancio open. Nel frattempo l'organizzazione GitHub è già aperta: seguila per vedere il primo commit quando esce.</p>
<div style="margin-top:8px"><Button variant="secondary" size="md" icon="github" href={SITE.github}>TriesteOpenRoboticsCommunity</Button></div>
</div>
</div>
</section>

<section style="padding:96px 64px 0">
<div style="max-width:1280px;margin:0 auto">
<SectionRule index="02 / 03" label="Filoni tecnologici" note="Sei discipline" mb="40px" />
<div style="display:grid;grid-template-columns:1.1fr .9fr;gap:80px;align-items:end;margin-bottom:40px">
<h2 style="font-family:var(--font-display);font-size:38px;font-weight:600;line-height:1.08;letter-spacing:-.028em;color:var(--text-strong);margin:0">Sei discipline, un solo progetto.</h2>
<p style="font-size:18px;line-height:1.62;color:var(--text-secondary);margin:0">Un robot funziona quando queste competenze lavorano nello stesso posto, sullo stesso problema.</p>
</div>
<div style="display:grid;grid-template-columns:repeat(2,1fr);gap:24px">
{DISCIPLINE.map((d, i) => (
  <div style={discCard}>
    <span class="torc-hud-label" style="color:var(--text-accent);padding-top:6px">{String(i + 1).padStart(2, '0')}</span>
    <div>
      <h3 style="font-family:var(--font-display);font-size:22px;font-weight:600;letter-spacing:-.015em;color:var(--text-strong);margin:0 0 8px">{d.title}</h3>
      <p style="font-size:16px;line-height:1.56;color:var(--text-secondary);margin:0">{d.body}</p>
    </div>
  </div>
))}
</div>
</div>
</section>

<section style="padding:96px 64px">
<div style="max-width:1280px;margin:0 auto">
<SectionRule index="03 / 03" label="Cosa ne nasce" mb="40px" />
<Esiti />
</div>
</section>
</div>

<section class="torc-field" data-field="scan" data-field-glow="lit" style="padding:80px 64px;border-top:1px solid var(--border-subtle)">
<div style="max-width:1280px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:40px">
<div><h2 style="font-family:var(--font-display);font-size:32px;font-weight:600;letter-spacing:-.025em;color:var(--text-strong);margin:0">Hai un problema su cui vuoi lavorare?</h2><span class="torc-hud-label" style="display:block;margin-top:10px">Portalo al primo incontro</span></div>
<Button variant="primary" size="lg" mono iconEnd="arrow-right" href="/entra/">Entra in TORC</Button>
</div>
</section>

</Base>
