---
import Base from '../layouts/Base.astro';
import SectionRule from '../components/SectionRule.astro';
import { NotifyBlock } from '../components/NotifyBlock.jsx';
import { SpecTable } from '../../design-system/components/content/SpecTable.jsx';
import { StatBlock } from '../../design-system/components/content/StatBlock.jsx';
import { StatusDot } from '../../design-system/components/feedback/StatusDot.jsx';
import { ROWS_MEETUP, ROADMAP } from '../content.js';
---

<Base
  title="Incontri — JoiNTS"
  description="Meetup e hackathon: un intervento tecnico, un problema aperto, il tempo per discuterne. Il calendario si definisce al primo incontro."
>

<section class="joints-field" data-field="contour" data-field-glow="wash" data-field-depth="hero" style="padding:112px 64px 64px">
<div style="max-width:1280px;margin:0 auto">
<span class="joints-kicker">Incontri</span>
<h1 style="font-family:var(--font-display);font-size:clamp(40px,4.6vw,64px);font-weight:600;line-height:1.04;letter-spacing:-.03em;color:var(--text-strong);margin:20px 0 0;max-width:26ch">Ci incontriamo di persona per confrontarci e condividere ciò che impariamo.</h1>
<div class="joints-ticks joints-ticks--major" style="margin-top:48px"></div>
</div>
</section>

<div data-theme="light" style="background:var(--bg-page);color:var(--text-body)">
<section style="padding:96px 64px 0">
<div style="max-width:1280px;margin:0 auto">
<SectionRule index="01 / 04" label="Prossimi appuntamenti" note="Calendario non ancora aperto" mb="40px" />
<!-- One of the site's two interactive islands: it needs JS to post the form
     and swap in the result, so it hydrates. Everything else on the page is
     static HTML. -->
<NotifyBlock client:load />
</div>
</section>

<section style="padding:96px 64px 0">
<div style="max-width:1280px;margin:0 auto">
<SectionRule index="02 / 04" label="Meetup" mb="40px" />
<div style="display:grid;grid-template-columns:1.1fr .9fr;gap:80px;align-items:start">
<h2 style="font-family:var(--font-display);font-size:38px;font-weight:600;line-height:1.08;letter-spacing:-.028em;color:var(--text-strong);margin:0">Un intervento tecnico, un problema aperto, il tempo per discuterne.</h2>
<SpecTable rows={ROWS_MEETUP} />
</div>
</div>
</section>
<div style="height:96px"></div>
</div>

<section class="joints-field" data-field="survey" data-field-glow="lit" data-field-depth="open" style="padding:96px 64px;border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle)">
<div style="max-width:1280px;margin:0 auto">
<SectionRule index="03 / 04" label="Hackathon e sfide" mb="40px" />
<div style="display:grid;grid-template-columns:1.1fr .9fr;gap:80px;align-items:end">
<div>
<h2 style="font-family:var(--font-display);font-size:44px;font-weight:600;line-height:1.04;letter-spacing:-.03em;color:var(--text-strong);margin:0;max-width:22ch">Due giorni, un obiettivo, un repository.</h2>
<p style="font-size:18px;line-height:1.62;color:var(--text-secondary);margin:24px 0 0;max-width:52ch">Il lavoro procede più rapidamente quando un gruppo si concentra su un solo problema, entro un tempo definito. Da uno sprint nasce il primo repository, che l'associazione porta poi a termine.</p>
<span class="joints-hud-label" style="display:block;margin-top:24px">Il risultato resta pubblico, con la storia dei commit</span>
</div>
<div style="display:flex;gap:56px">
<StatBlock value="48" accentPart="h" label="durata dello sprint" />
<StatBlock value="1" label="obiettivo, definito in anticipo" />
</div>
</div>
</div>
</section>

<div data-theme="light" style="background:var(--bg-page);color:var(--text-body)">
<section style="padding:96px 64px">
<div style="max-width:1280px;margin:0 auto">
<SectionRule index="04 / 04" label="Roadmap operativa" note="Quattro passi, in sequenza" mb="40px" />
<h2 style="font-family:var(--font-display);font-size:38px;font-weight:600;line-height:1.08;letter-spacing:-.028em;color:var(--text-strong);margin:0 0 40px">Quattro passi, in sequenza.</h2>
<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:24px">
{ROADMAP.map((step, i) => (
  <div style={`border-top:${i === 0 ? '1.5px solid var(--accent)' : '1px solid var(--border-subtle)'};padding-top:20px;display:flex;flex-direction:column;gap:10px`}>
    {/* No `state`: the dc version asked for tone="ok" live, but StatusDot's
        only state prop is `state`, so those were ignored and it has always
        rendered the idle dot. Kept as-is — making it live is a design change,
        not part of this migration. */}
    {step.dot
      ? <div style="display:flex;align-items:center;gap:10px"><span class="joints-hud-label">{String(i + 1).padStart(2, '0')}</span><StatusDot /></div>
      : <span class="joints-hud-label">{String(i + 1).padStart(2, '0')}</span>}
    <h3 style="font-family:var(--font-display);font-size:22px;font-weight:600;letter-spacing:-.02em;color:var(--text-strong);margin:0">{step.title}</h3>
    <p style="font-size:16px;line-height:1.56;color:var(--text-secondary);margin:0">{step.body}</p>
  </div>
))}
</div>
</div>
</section>
</div>

</Base>
