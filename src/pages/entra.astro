---
import Base from '../layouts/Base.astro';
import SectionRule from '../components/SectionRule.astro';
import Channels from '../components/Channels.astro';
import { JoinForm } from '../components/JoinForm.jsx';
import { Button } from '../../design-system/components/core/Button.jsx';
import { SpecTable } from '../../design-system/components/content/SpecTable.jsx';
import { SITE, JOIN_STEPS, ROWS_CONTATTI } from '../content.js';
---

<Base
  title="Entra in TORC"
  description="Come si entra in TORC: scrivici, vieni al primo incontro, porta un problema su cui vuoi lavorare."
>

<section class="torc-field" data-field="scan" data-field-glow="lit" data-field-depth="hero" style="padding:112px 64px 64px">
<div style="max-width:1280px;margin:0 auto">
<span class="torc-kicker">Entra in TORC</span>
<h1 style="font-family:var(--font-display);font-size:clamp(48px,5.6vw,80px);font-weight:600;line-height:1;letter-spacing:-.03em;color:var(--text-strong);margin:20px 0 0">Iniziamo a costruire.</h1>
<p style="font-size:20px;line-height:1.62;color:var(--text-secondary);max-width:54ch;margin:24px 0 0">Se leggendo il manifesto hai pensato «questo è il luogo che stavo cercando», allora probabilmente lo è.</p>
</div>
</section>

<div data-theme="light" style="background:var(--bg-page);color:var(--text-body)">
<section style="padding:96px 64px 0">
<div style="max-width:1280px;margin:0 auto">
<SectionRule index="01 / 04" label="Come si entra" note="Tre passi" mb="40px" />
<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:48px">
{JOIN_STEPS.map((step, i) => (
  <div style={`border-top:${i === 0 ? '1.5px solid var(--accent)' : '1px solid var(--border-subtle)'};padding-top:20px`}>
    <span class="torc-hud-label">{String(i + 1).padStart(2, '0')}</span>
    <h3 style="font-family:var(--font-display);font-size:24px;font-weight:600;letter-spacing:-.02em;color:var(--text-strong);margin:10px 0 0">{step}</h3>
  </div>
))}
</div>
</div>
</section>

<section style="padding:96px 64px 0">
<div style="max-width:1280px;margin:0 auto">
<SectionRule index="02 / 04" label="Raccontaci cosa sai fare" mb="40px" />
<div style="display:grid;grid-template-columns:1.15fr .85fr;gap:80px;align-items:start">
<!-- The second of the site's two islands. -->
<JoinForm client:load />
<div style="border-left:1px solid var(--border-subtle);padding-left:40px;display:flex;flex-direction:column;gap:16px">
<span class="torc-hud-label">Oppure, subito</span>
<Button variant="secondary" size="md" icon="message-square" href={SITE.whatsapp} block>Gruppo WhatsApp</Button>
<p style="font-size:15px;line-height:1.56;color:var(--text-secondary);margin:0">Il canale di confronto quotidiano tra i soci. L'ingresso viene approvato da un admin.</p>
<Button variant="secondary" size="md" icon="github" href={SITE.github} block>GitHub</Button>
<p style="font-size:15px;line-height:1.56;color:var(--text-secondary);margin:0">Tutti i repository, pubblici dal primo commit.</p>
</div>
</div>
</div>
</section>

<section style="padding:96px 64px 0">
<div style="max-width:1280px;margin:0 auto">
<SectionRule index="03 / 04" label="La casa digitale" note="Cinque canali" mb="40px" />
<Channels />
</div>
</section>

<section style="padding:96px 64px">
<div style="max-width:1280px;margin:0 auto">
<SectionRule index="04 / 04" label="Contatti" mb="40px" />
<SpecTable rows={ROWS_CONTATTI} />
</div>
</section>
</div>

</Base>
