---
// Sticky blurred header. The nav is real links now, so the active state comes
// from the URL rather than from router state.
//
// Layout lives in the scoped <style> below rather than in inline attributes,
// because the header has to reflow on narrow screens and inline styles cannot
// carry a media query. Values are design-system tokens; the two that are not
// (72px header, 1440px column) predate this file and are kept as they were.
import { Logo } from '../../design-system/components/brand/Logo.jsx';
import { Button } from '../../design-system/components/core/Button.jsx';
import { NAV } from '../content.js';

// Compare both sides in the same shape — hrefs carry a trailing slash, the
// dev server and the built site do not always agree on whether the URL does.
const norm = (p: string) => (p.endsWith('/') ? p : p + '/');
const path = norm(Astro.url.pathname);
---

<header class="hdr">
  <div class="hdr__row">
    <a href="/" class="hdr__home" aria-label="JoiNTS — home"><Logo variant="lockup" height={24} /></a>
    <nav class="hdr__nav">
      {NAV.map((item) => (
        <a class="hdr__link" href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    {/* A sibling of the nav, not a child: on narrow screens it has to sit on
        the logo's row while the links drop below, and flex `order` can only
        reorder elements that share a parent. */}
    <span class="hdr__actions">
      <Button size="sm" variant="secondary" icon="lock" href="/officina/">Area soci</Button>
      <Button size="sm" variant="primary" href="/entra/">Entra</Button>
    </span>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 60;
    height: 72px;
    display: flex;
    align-items: center;
    padding: 0 var(--page-gutter-lg);
    background: var(--surface-header);
    backdrop-filter: blur(14px);
    border-bottom: var(--border-hairline) solid var(--border-subtle);
  }
  /* No gap: the nav's auto margin does the separating, so the spacing between
     nav and actions stays deliberate rather than inheriting a row gap. */
  .hdr__row {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
  }
  .hdr__home { display: flex; align-items: center; }
  .hdr__nav {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-left: auto;
  }
  .hdr__link {
    display: inline-flex;
    align-items: center;
    height: var(--control-h-sm);
    padding: 0 var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    text-decoration: none;
    color: var(--text-secondary);
  }
  .hdr__link:hover { color: var(--text-body); text-decoration: none; }
  .hdr__link[aria-current="page"] { color: var(--text-accent); }
  .hdr__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: var(--space-3);
  }

  /* Below this width the row cannot hold logo + links + both actions on one
     line, so it becomes two: logo and actions on top, links underneath. */
  @media (max-width: 860px) {
    .hdr { height: auto; padding: var(--space-3) var(--space-5); }
    .hdr__row { flex-wrap: wrap; row-gap: var(--space-3); }
    .hdr__actions { order: 2; margin-left: auto; }
    .hdr__nav {
      order: 3;
      width: 100%;
      margin-left: 0;
      flex-wrap: wrap;
      row-gap: var(--space-2);
    }
    /* The links carry their own padding; pull the row flush with the logo. */
    .hdr__link:first-child { padding-left: 0; }
  }
</style>
